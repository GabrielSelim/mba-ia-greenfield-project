# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
# Single quotes: the value has "<" and ">" and this file is also parsed by Docker Compose.
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Object storage (S3 API — MinIO locally, AWS S3 in production)
# S3_ENDPOINT is used service-to-service (Compose service name).
# S3_PUBLIC_ENDPOINT is only used to sign URLs handed to clients (browser/curl);
# minio.localhost resolves to 127.0.0.1 on the host and is a network alias of
# the `minio` service inside Compose.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://minio.localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=streamtube-videos

# Queue (BullMQ on Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Videos
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_MB=100
VIDEO_URL_TTL_SECONDS=3600
VIDEO_PROCESSING_ATTEMPTS=3
VIDEO_PROCESSING_BACKOFF_MS=5000
VIDEO_FFMPEG_TIMEOUT_MS=300000
